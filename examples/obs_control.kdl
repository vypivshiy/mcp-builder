// =============================================================================
// obs_control.kdl - OBS Studio WebSocket v5 Control Bridge
// Compiled with mcp-builder / mcp-gen (KDL 2.0)
//
// How to test:
// 1. Open OBS Studio -> Tools -> WebSocket Server Settings.
// 2. Enable WebSocket server on port 4455 (default).
// 3. Compile and run this MCP server:
//    mcp-builder build examples/obs_control.kdl -o obs_mcp.exe
// =============================================================================

server name="obs-studio-bridge" version="1.0.0" {
    description "Native MCP server for live streaming and recording control in OBS Studio via WebSocket v5"
    author "Broadcasting Tools Team"
    license "MIT"
    protocol-version "2024-11-05"
}

transports {
    stdio enabled=#true
}

env {
    OBS_HOST default="127.0.0.1" description="OBS Studio WebSocket host"
    OBS_PORT default="4455" description="OBS Studio WebSocket port"
}

// -----------------------------------------------------------------------------
// 1. Get OBS Stats (FPS, CPU usage, memory, disk space)
// -----------------------------------------------------------------------------
tool "obs_get_stats" description="Retrieves runtime statistics including active FPS, render lag, and CPU usage" {
    bind:ws url="ws://{env:OBS_HOST}:{env:OBS_PORT}" {
        message "{\"op\":6,\"d\":{\"requestType\":\"GetStats\",\"requestId\":\"req_stats\"}}"
        timeout-ms 5000
        extract-json "/d/responseData"
    }

    output {
        format "json"
        trim #true
    }
}

// -----------------------------------------------------------------------------
// 2. Get Current Program Scene & Scene List
// -----------------------------------------------------------------------------
tool "obs_get_scene_list" description="Gets the list of available scenes and the currently active program scene" {
    bind:ws url="ws://{env:OBS_HOST}:{env:OBS_PORT}" {
        message "{\"op\":6,\"d\":{\"requestType\":\"GetSceneList\",\"requestId\":\"req_scenes\"}}"
        timeout-ms 5000
        extract-json "/d/responseData"
    }

    output {
        format "json"
        trim #true
    }
}

// -----------------------------------------------------------------------------
// 3. Switch Current Program Scene
// -----------------------------------------------------------------------------
tool "obs_set_current_scene" description="Switches the live program scene to the specified scene name" {
    (string)param "scene_name" required=#true description="Target scene name to switch to"

    bind:ws url="ws://{env:OBS_HOST}:{env:OBS_PORT}" {
        message "{\"op\":6,\"d\":{\"requestType\":\"SetCurrentProgramScene\",\"requestId\":\"req_switch\",\"requestData\":{\"sceneName\":\"{scene_name}\"}}}"
        timeout-ms 5000
    }

    output {
        format "text"
        trim #true
    }
}

// -----------------------------------------------------------------------------
// 4. Toggle Recording State
// -----------------------------------------------------------------------------
tool "obs_toggle_record" description="Toggles video recording start/stop in OBS Studio" {
    bind:ws url="ws://{env:OBS_HOST}:{env:OBS_PORT}" {
        message "{\"op\":6,\"d\":{\"requestType\":\"ToggleRecord\",\"requestId\":\"req_rec\"}}"
        timeout-ms 5000
        extract-json "/d/responseData/outputActive"
    }

    output {
        format "text"
        trim #true
    }
}
